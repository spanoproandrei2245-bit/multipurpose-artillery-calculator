{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Artillery Calculator",
  "version": "../package.json",
  "identifier": "com.heis.artillery-calculator",
  "build": {
    "beforeDevCommand": "npm run dev -- --port 5173 --strictPort",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Artillery Calculator",
        "width": 1200,
        "height": 900,
        "minWidth": 380,
        "minHeight": 500
      },
      {
        "label": "overlay",
        "title": "Artillery Overlay",
        "url": "index.html#overlay",
        "width": 340,
        "height": 250,
        "minWidth": 240,
        "minHeight": 160,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "shortDescription": "Arma 3 ACE3 artillery calculator",
    "copyright": "made by Heis"
  }
}
